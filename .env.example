# Copy to .env and replace every "change-me" value. Never commit .env.
# `make setup` refuses to continue while any value below is empty or still "change-me".

# Warehouse PostgreSQL (container superuser; used only for migrations and tests)
WAREHOUSE_DB=claims_warehouse
WAREHOUSE_ADMIN_USER=warehouse_admin
WAREHOUSE_ADMIN_PASSWORD=change-me
# Application roles created by `claims-dw migrate`
LOADER_PASSWORD=change-me
TRANSFORMER_PASSWORD=change-me
DASHBOARD_PASSWORD=change-me

# Airflow metadata database and secrets
AIRFLOW_DB_PASSWORD=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me

# Pipeline
CLAIMS_DW_SOURCE=cms
COHORT_SIZE=1000
LOG_LEVEL=INFO

# Host ports (bound to 127.0.0.1 only)
WAREHOUSE_HOST_PORT=55432
AIRFLOW_HOST_PORT=8080
DASHBOARD_HOST_PORT=8501
